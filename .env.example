# Copy to .env (git-ignored). Real environment variables always win over this file.

# ------------------------------------------------------------------ eLabFTW (both apps)
# API key: eLabFTW -> your profile -> API keys (needs write access for the assistant, read for the chatbot)
ELABFTW_API_KEY=
ELABFTW_URL=https://localhost:8443/api/v2
# TLS: unset = verify, except for localhost (self-signed certificate). true | false | /path/to/ca.pem
#ELABFTW_VERIFY_TLS=
#ELABFTW_SITE_URL=https://localhost:8443      # for the "open in eLabFTW" links; derived from ELABFTW_URL if unset
#ELABFTW_TIMEOUT=30
#ELABFTW_PAGE_SIZE=100

# ------------------------------------------------------------------ Ollama (both apps)
OLLAMA_HOST=http://localhost:11434

# ------------------------------------------------------------------ Lab Assistant
#LAB_ASSISTANT_MODEL=qwen2.5:7b
#LAB_VISION_MODEL=minicpm-v4.6:1b
#LAB_ASSISTANT_NUM_CTX=8192
#LAB_WHISPER_DIR=models/whisper/base          # local faster-whisper model (offline)
#LAB_WHISPER_LANGUAGE=de

# ------------------------------------------------------------------ Lab Chatbot
#LAB_CHAT_MODEL=qwen2.5:7b
#LAB_EMBED_MODEL=embeddinggemma
#LAB_NUM_CTX=8192
#LAB_TOP_K=6                                  # passages handed to the model
#LAB_MIN_DENSE=0.30                           # minimum cosine similarity for a semantic hit
#LAB_MAX_CONTEXT_CHARS=9000
#LAB_HISTORY_TURNS=3
#LAB_DEFAULT_LANGUAGE=de                      # language of fixed answers when a question is ambiguous (de|en)
#LAB_DB_PATH=data/chatbot/labbook.db
#LAB_DATA_DIR=data
#LAB_OLLAMA_TIMEOUT=300                       # seconds before a hung Ollama request fails (all apps)
#LAB_INDEX_IMAGES=false                       # true: read image attachments during sync (slow on first run)
#LAB_MAX_IMAGE_MB=20                          # larger images are skipped (sync) or rejected (chat upload)
#LAB_MAX_IMAGES_PER_EXPERIMENT=10
#LAB_VECTOR_DIMS=0                            # 0 = full vectors in RAM; e.g. 256 only for Matryoshka models (embeddinggemma, nomic-embed-text v1.5, mxbai-embed-large, qwen3-embedding)
#LAB_SYNC_INTERVAL=900                        # seconds between sync rounds of `python -m lab_chatbot worker` (minimum 60)
#LAB_MAX_CONCURRENT_LLM=1                     # parallel answer generations; raise only with OLLAMA_NUM_PARALLEL > 1 and enough VRAM
#LAB_LLM_QUEUE_TIMEOUT=600                    # seconds a question may wait in the queue
#LAB_QUERY_LOG=true                           # false: do not store questions in the local index database
#LAB_RERANK_MODEL=                            # e.g. BAAI/bge-reranker-v2-m3; needs sentence-transformers (pip install -e ".[rerank]")
