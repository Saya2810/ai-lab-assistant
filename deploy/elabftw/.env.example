# Copy to deploy/elabftw/.env (git-ignored) and fill in. No value below is a real secret.

# uid/gid the eLabFTW container runs as:  id -u && id -g   (e.g. 1000 on most Linux, 501/20 on macOS)
ELAB_UID=1000
ELAB_GID=1000

# generate strong random passwords, e.g.:  openssl rand -base64 24
ELAB_DB_PASSWORD=
ELAB_MYSQL_ROOT_PASSWORD=

# MUST be generated by eLabFTW itself, not made up:
#   docker run --rm -t --entrypoint '/bin/sh' elabftw/elabimg:stable \
#     -c "php -d memory_limit=10M -d open_basedir='' bin/init tools:genkey"
# (or https://get.elabftw.net/?key). Keep it stable: changing it breaks stored SMTP/timestamp passwords.
ELAB_SECRET_KEY=
